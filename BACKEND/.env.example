# VetAssist AI — versão NUVEM (celular). Copie para ".env" e preencha.
# Na hospedagem, estes valores são cadastrados como "Environment
# Variables" no painel do provedor (não suba o .env para o repositório).

# --- Obrigatórios ---

# Chave da OpenAI (sugestões, transcrição na nuvem e prontuário).
OPENAI_API_KEY=

# Senha de acesso do veterinário. OBRIGATÓRIA na nuvem: sem ela,
# qualquer um com o endereço abriria a tela do vet, veria prontuários
# e gastaria a sua chave da OpenAI. Escolha uma senha forte.
VET_SENHA=

# --- Transcrição ---

# Na nuvem use "nuvem" (a máquina do servidor não roda o modelo local).
TRANSCRICAO=nuvem
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
WHISPER_MODEL=medium

# --- Dados do veterinário (telas e prontuário) ---
NOME_CLINICA=VetAssist AI
NOME_VETERINARIO=
CRMV=
TELEFONE=

# --- Armazenamento (opcional) ---
# Aponte para um disco persistente do provedor, senão os prontuários
# se perdem a cada novo deploy. Ex.: DATA_DIR=/data
DATA_DIR=
